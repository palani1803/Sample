# Backend Server Configuration Template
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Free LLM API Providers ---
# 1. NVIDIA NIM (Pre-configured)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# 2. Groq (Free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter (Free models at https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Google Gemini (Free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Cerebras (Free 1M tokens/day at https://cloud.cerebras.ai)
CEREBRAS_API_KEY=your_cerebras_api_key_here
